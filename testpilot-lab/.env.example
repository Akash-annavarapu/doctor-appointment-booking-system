# Set on the STANDALONE Lab Render web service (not the healthcare frontend).
# Free Gemini is selected by default; OpenAI only when explicitly opted in.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEST_MODEL=gemini-3.5-flash-lite
# Optional paid alternative: AI_PROVIDER=openai, OPENAI_API_KEY and OPENAI_TEST_MODEL
OPENAI_API_KEY=
OPENAI_TEST_MODEL=gpt-4.1-mini
# Set a random independent access code with at least 16 characters.
LAB_ACCESS_CODE=
PORT=5050
